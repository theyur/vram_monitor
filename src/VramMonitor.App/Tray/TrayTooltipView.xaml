<UserControl x:Class="VramMonitor.App.Tray.TrayTooltipView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tray="clr-namespace:VramMonitor.App.Tray"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=tray:TrayTooltipModel}">

    <!-- A WPF tooltip rather than the Win32 one: NOTIFYICONDATA.szTip caps out at 127 characters,
         which five name-and-value rows can exceed. -->
    <Border Background="#FF1E2733" CornerRadius="6" Padding="12,10" MinWidth="230">
        <StackPanel>
            <TextBlock Text="Top VRAM consumers" Foreground="#FF9AA6B8" FontSize="10.5"
                       FontWeight="SemiBold" Margin="0,0,0,6" />

            <ItemsControl ItemsSource="{Binding Entries}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!-- Left, not the default stretch: with a MaxWidth, stretch centres the name
                                 inside a wider column, so the list drifted right whenever the total row
                                 below made the tooltip wider than the names. -->
                            <TextBlock Text="{Binding Name}" Foreground="White" FontSize="12"
                                       HorizontalAlignment="Left"
                                       TextTrimming="CharacterEllipsis" MaxWidth="170" />
                            <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="#FF7DD3A0"
                                       FontSize="12" FontWeight="SemiBold" Margin="12,0,0,0" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- The adapter total as one more row of the same table, so its figure lines up with the
                 consumers above it. Deliberately left in the footer grey rather than the row colours: it is
                 read from the adapter counter and is not the sum of the rows, so it must not read as just
                 another consumer. The label doubles as the status line when there is nothing to list,
                 which is why it still wraps. -->
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Footer}" Foreground="#FF8A94A6" FontSize="12"
                           TextWrapping="Wrap" MaxWidth="260" />
                <TextBlock Grid.Column="1" Text="{Binding TotalValue}" Foreground="#FF8A94A6" FontSize="12"
                           FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Top" />
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
