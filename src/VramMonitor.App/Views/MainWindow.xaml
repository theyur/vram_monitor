<Window x:Class="VramMonitor.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:oxy="http://oxyplot.org/wpf"
        xmlns:vm="clr-namespace:VramMonitor.App.ViewModels"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="VRAM Monitor" Height="740" Width="1280" MinHeight="520" MinWidth="900"
        Background="#FFFBFCFD">

    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#FF2B3240" />
            <Setter Property="Margin" Value="10,10,10,6" />
        </Style>

        <Style x:Key="ColumnHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="#FF8A94A6" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- One row template drives both lists, so Aggressive and Other stay visually identical:
             the only difference between them is classification, not importance. -->
        <DataTemplate x:Key="ConsumerTemplate" DataType="{x:Type vm:ConsumerRow}">
            <Border Padding="8,6" Margin="0,1" CornerRadius="4" Background="Transparent">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="86" />
                            <ColumnDefinition Width="86" />
                            <ColumnDefinition Width="86" />
                            <ColumnDefinition Width="76" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{Binding DisplayName}" FontSize="12.5" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding ExecutablePath}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding Current}" TextAlignment="Right" FontSize="12.5"
                                   ToolTip="{Binding CurrentTooltip}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding Average}" TextAlignment="Right" FontSize="12.5"
                                   Foreground="#FF5A6274" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="{Binding Peak}" TextAlignment="Right" FontSize="12.5"
                                   Foreground="#FF5A6274" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="4" Text="{Binding AggressiveTime}" TextAlignment="Right" FontSize="12.5"
                                   Foreground="#FF5A6274" VerticalAlignment="Center" />
                        <ToggleButton Grid.Column="5" Margin="8,0,0,0" Width="22" Height="20" FontSize="10"
                                      Content="⌄" Tag="{Binding Key}"
                                      Click="OnToggleExpand" ToolTip="Show individual processes" />
                    </Grid>

                    <!-- Details live behind expansion, keeping the default row to the five columns
                         spec section 11.1 asks for. -->
                    <StackPanel Margin="6,6,0,2"
                                Visibility="{Binding Key, Converter={StaticResource ExpansionConverter}}">
                        <TextBlock Text="{Binding ExecutablePath}" FontSize="11" Foreground="#FF6B7488"
                                   TextWrapping="Wrap" />
                        <TextBlock FontSize="11" Foreground="#FF6B7488">
                            <Run Text="{Binding ProcessCount, Mode=OneWay}" />
                            <Run Text=" · shared " /><Run Text="{Binding Shared, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Text="{Binding IdentityNote}" FontSize="11" Foreground="#FFB26A00"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding IdentityNote, Converter={StaticResource EmptyToCollapsed}}" />
                        <ItemsControl ItemsSource="{Binding Sessions}" Margin="0,4,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:SessionRow}">
                                    <TextBlock FontSize="11" Foreground="#FF5A6274" Margin="0,1">
                                        <Run Text="{Binding Pid, Mode=OneWay}" FontWeight="SemiBold" />
                                        <Run Text=" · " /><Run Text="{Binding Current, Mode=OneWay}" />
                                        <Run Text=" · " /><Run Text="{Binding Started, Mode=OneWay}" />
                                        <Run Text=" · " /><Run Text="{Binding Seen, Mode=OneWay}" />
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <Style x:Key="ConsumerList" TargetType="ListBox">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="ItemTemplate" Value="{StaticResource ConsumerTemplate}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />

            <!-- Clicking the already-selected row deselects it. SelectionChanged cannot do this: it does
                 not fire when the selected item is clicked again. -->
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnConsumerPreviewMouseDown" />

            <!-- Both lists sit in the StackPanel of one outer ScrollViewer, so they are laid out at full
                 height and never scroll themselves, yet their own ScrollViewer still marks the wheel event
                 handled. That left the wheel dead, with the scrollbar the only way to move. -->
            <EventSetter Event="PreviewMouseWheel" Handler="OnConsumerListMouseWheel" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Blocking startup problems are surfaced once, here, rather than as a dialog (spec 16.3). -->
        <Border DockPanel.Dock="Top" Background="#FFFFF4E5" Padding="12,8" BorderBrush="#FFE8C98A"
                BorderThickness="0,0,0,1"
                Visibility="{Binding BlockingError, Converter={StaticResource EmptyToCollapsed}}">
            <TextBlock Text="{Binding BlockingError}" TextWrapping="Wrap" Foreground="#FF7A4E00" FontSize="12" />
        </Border>

        <Border DockPanel.Dock="Top" Padding="12,10" Background="White" BorderBrush="#FFE6EAF0"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding GpuName}" FontSize="14" FontWeight="SemiBold" Foreground="#FF1E2733" />
                    <TextBlock Text="Per-application values can sum above the total line: Windows attributes shared surfaces to every process that references them."
                               FontSize="10.5" Foreground="#FF8A94A6" Margin="0,2,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Only way back to the undimmed chart other than Esc or clicking the selected row
                         again, so it is shown whenever a selection is actually in force. -->
                    <Button Content="Show all lines" Click="OnClearSelection" Padding="12,5" Margin="0,0,8,0"
                            ToolTip="Clear the selection and undim every line (Esc)"
                            Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisible}}" />
                    <Button Content="Export…" Click="OnExport" Padding="12,5" Margin="0,0,8,0" />
                    <Button Content="Settings…" Click="OnSettings" Padding="12,5" />
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="#FFF3F5F8" Padding="12,6" BorderBrush="#FFE6EAF0"
                BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding StatusLine}" FontSize="11" Foreground="#FF5A6274" />
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="480" MinWidth="360" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <DockPanel Background="White">
                <Grid DockPanel.Dock="Top" Margin="10,8,10,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="86" />
                        <ColumnDefinition Width="86" />
                        <ColumnDefinition Width="86" />
                        <ColumnDefinition Width="76" />
                        <ColumnDefinition Width="30" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="APPLICATION" Style="{StaticResource ColumnHeader}" />
                    <TextBlock Grid.Column="1" Text="CURRENT" Style="{StaticResource ColumnHeader}" TextAlignment="Right" />
                    <TextBlock Grid.Column="2" Text="AVERAGE" Style="{StaticResource ColumnHeader}" TextAlignment="Right" />
                    <TextBlock Grid.Column="3" Text="PEAK" Style="{StaticResource ColumnHeader}" TextAlignment="Right" />
                    <TextBlock Grid.Column="4" Text="AGGR. TIME" Style="{StaticResource ColumnHeader}" TextAlignment="Right" />
                </Grid>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{Binding AggressiveHeader}" Style="{StaticResource SectionHeader}" />
                        <ListBox x:Name="AggressiveList" ItemsSource="{Binding Aggressive}"
                                 Style="{StaticResource ConsumerList}"
                                 SelectionChanged="OnConsumerSelected" />

                        <TextBlock Text="{Binding OtherHeader}" Style="{StaticResource SectionHeader}" />
                        <ListBox x:Name="OtherList" ItemsSource="{Binding Other}"
                                 Style="{StaticResource ConsumerList}"
                                 SelectionChanged="OnConsumerSelected" />

                        <TextBlock Margin="10,4,10,12" FontSize="10.5" Foreground="#FF8A94A6" TextWrapping="Wrap"
                                   Visibility="{Binding HasHiddenOtherRows, Converter={StaticResource BoolToVisible}}"
                                   Text="Some consumers are hidden by the display filter. They are still retained, analysed and exported." />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="#FFE6EAF0" />

            <oxy:PlotView Grid.Column="2" Model="{Binding Plot}" Background="White" Margin="0" />
        </Grid>
    </DockPanel>
</Window>
